# ---- Firebase web app config (Firebase console > Project settings > Your apps) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- App Check ----
# Site key of the provider registered in Firebase console > App Check > Apps.
VITE_RECAPTCHA_SITE_KEY=
# "enterprise" (default: reCAPTCHA Enterprise / Fraud Defense) or "v3" (classic reCAPTCHA v3).
VITE_APPCHECK_PROVIDER=enterprise
# Optional: stable App Check debug token for local dev (register it in the console).
# Leave empty to auto-generate one (printed in the browser console). NEVER commit a real value.
VITE_APPCHECK_DEBUG_TOKEN=

# ---- Models ----
# Overridden at runtime by the Remote Config key `cloud_model`.
VITE_CLOUD_MODEL=gemini-3.5-flash
